#!/usr/bin/env bash
# HHKB を繋いでいる間だけ、MacBook の内蔵キーボードを無効にする (KDE Plasma の Wayland 用)。
#
# 内蔵キーボードとトラックパッドは同じ名前なので kcminputrc のグループも同じで、
# KWin はそこへ Enabled を保存する。キーボードを無効にした後で保存値を true に書き直す。
# こうすると、このサービスが動かなくても次の KWin は両方有効で始まる。
# トラックパッドの enabled を切り替えるとタッチが切れるので、値が違うときしか触らない。

readonly HHKB_NAME='HHKB-Hybrid_1 Keyboard'
readonly INTERNAL_NAME='Apple Inc. Apple Internal Keyboard / Trackpad'
readonly SERVICE=org.kde.KWin
readonly ROOT=/org/kde/KWin/InputDevice
readonly IFACE=org.kde.KWin.InputDevice

prop() {
    busctl --user get-property "$SERVICE" "$ROOT/$1" "$IFACE" "$2" 2>/dev/null
}

set_enabled() {
    if [[ $(prop "$1" enabled) != "b $2" ]]; then
        busctl --user set-property "$SERVICE" "$ROOT/$1" "$IFACE" enabled b "$2"
    fi
}

devices() {
    busctl --user get-property "$SERVICE" "$ROOT" org.kde.KWin.InputDeviceManager \
        devicesSysNames 2>/dev/null | grep -o '"[^"]*"' | tr -d '"'
}

# KWin が保存した Enabled=false を、次の起動に残さない
save_enabled_true() {
    local vendor product
    vendor=$(prop "$1" vendor)
    product=$(prop "$1" product)
    kwriteconfig6 --file kcminputrc \
        --group Libinput --group "${vendor#u }" --group "${product#u }" \
        --group "$INTERNAL_NAME" --key Enabled true
}

reconcile() {
    local dev name hhkb=false keyboards=() trackpads=() missing=()

    while read -r dev; do
        name=$(prop "$dev" name)
        case "$name" in
            '')
                missing+=("$dev")
                ;;
            "s \"$HHKB_NAME\"")
                hhkb=true
                ;;
            "s \"$INTERNAL_NAME\"")
                if [[ $(prop "$dev" touchpad) == 'b true' ]]; then
                    trackpads+=("$dev")
                elif [[ $(prop "$dev" alphaNumericKeyboard) == 'b true' ]]; then
                    keyboards+=("$dev")
                fi
                ;;
        esac
    done < <(devices)

    local want=true
    [[ $hhkb == true ]] && want=false

    local actual=()
    for dev in "${keyboards[@]}"; do
        set_enabled "$dev" "$want"
        actual+=("$dev:$(prop "$dev" enabled)")
    done
    for dev in "${trackpads[@]}"; do
        set_enabled "$dev" true
    done
    for dev in "${keyboards[@]}" "${trackpads[@]}"; do
        save_enabled_true "$dev"
        break
    done

    # 望んだ値ではなく、KWin から読み直した値を出す
    echo "hhkb=$hhkb want-internal-keyboard=$want actual=${actual[*]:-none}"
    if [[ ${#keyboards[@]} -eq 0 ]]; then
        echo "warning: internal keyboard not found on D-Bus" >&2
    fi
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "warning: listed by KWin but no D-Bus object: ${missing[*]}" >&2
    fi
}

restore() {
    local dev
    while read -r dev; do
        if [[ $(prop "$dev" name) == "s \"$INTERNAL_NAME\"" ]]; then
            set_enabled "$dev" true
        fi
    done < <(devices)
}

trap 'restore; exit 0' TERM INT

# 信号が 1 秒途切れるのを待って、一度だけ状態を合わせる。スリープ復帰では信号がまとめて来る。
# dbus-monitor 自身の開始シグナルも含むので、起動時にも一度走る。
while read -r line; do
    case "$line" in
        signal*)
            while read -r -t 1 line; do :; done
            reconcile
            ;;
    esac
done < <(dbus-monitor --session \
    "type='signal',interface='org.kde.KWin.InputDeviceManager',member='deviceAdded'" \
    "type='signal',interface='org.kde.KWin.InputDeviceManager',member='deviceRemoved'")

exit 1
